# Required: your Anthropic API key (console.anthropic.com). Never ship this in the app.
ANTHROPIC_API_KEY=
# Optional
PORT=8787
HARRY_DB=./data/harry.db
HARRY_MODEL=claude-opus-5-5
HARRY_TRIAGE_MODEL=claude-haiku-5-5
# Fast mode: ~2.5x faster replies on Opus 5.5 at 2x price. Set to false to save cost.
HARRY_FAST_MODE=true
HARRY_DAILY_AI_LIMIT=400
